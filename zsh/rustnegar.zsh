# --- Dosu auto-launch -------------------------------------------------------
# در .zshrc قرار بده: cat zsh/rustnegar.zsh >> ~/.zshrc
#
# - فقط برای شل‌های تعاملی و وقتی از قبل داخل dosu نیستیم اجرا می‌شه
#   (باینری خودش متغیر DOSU رو ست می‌کنه تا از اجرای تودرتو جلوگیری بشه).
# - مسیر باینری رو با محل نصب واقعی‌ات جایگزین کن.

DOSU_BIN="${DOSU_BIN:-/usr/local/bin/dosu}"

if [[ -o interactive ]] && [[ -z "$DOSU" ]] && [[ -x "$DOSU_BIN" ]]; then
  exec "$DOSU_BIN"
fi
# ---------------------------------------------------------------------------
